\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Mechanism map and causal test plan.} \textbf  {A:} Direct is tested for terminal multi-source aggregation and, only when the counting predicate precedes the records, for causal use of the shared record-end states \(H_i\). CoT is tested for recurrent targeted-source retrieval, trace writing, semantic progress, and next-source or stop control. \textbf  {B:} Registered hidden states separate Direct terminal \(Z_D\), predicate-conditioned record-end \(H_i\), CoT retrieval \(Q_k\), and CoT progress \(P_k\). Local counter claims require held-out decoding, correct \(+1/0\) dynamics, and downstream transport; terminal states require total decoding and causal readout. \textbf  {C:} Attention nominates broad-aggregation, targeted-retrieval, and progress-transition candidates; query-local ablation and clean patching assign function. \textbf  {D:} A mechanism claim requires time-indexed effects on source identity/coverage, progress or stopping, terminal state, and the complete answer. The common-evidence control supplies both modes with the same correct source set to isolate state construction and readout. Miniature trajectories and heatmaps are analysis templates, not empirical results.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{3}{\textbf {Mechanism map and causal test plan.} \textbf {A:} Direct is tested for terminal multi-source aggregation and, only when the counting predicate precedes the records, for causal use of the shared record-end states \(H_i\). CoT is tested for recurrent targeted-source retrieval, trace writing, semantic progress, and next-source or stop control. \textbf {B:} Registered hidden states separate Direct terminal \(Z_D\), predicate-conditioned record-end \(H_i\), CoT retrieval \(Q_k\), and CoT progress \(P_k\). Local counter claims require held-out decoding, correct \(+1/0\) dynamics, and downstream transport; terminal states require total decoding and causal readout. \textbf {C:} Attention nominates broad-aggregation, targeted-retrieval, and progress-transition candidates; query-local ablation and clean patching assign function. \textbf {D:} A mechanism claim requires time-indexed effects on source identity/coverage, progress or stopping, terminal state, and the complete answer. The common-evidence control supplies both modes with the same correct source set to isolate state construction and readout. Miniature trajectories and heatmaps are analysis templates, not empirical results}{figure.caption.1}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][2][]3}{}{}{}}
